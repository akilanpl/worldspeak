# WorldSpeak environment placeholders (Phase 1: local only, no cloud keys).
# Copying this file is optional in Phase 1. Never commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Phase 2: supplied by the human at the cloud provisioning gate (never commit real values).
# NEXT_PUBLIC_SUPABASE_URL=https://<worldspeak-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only, never NEXT_PUBLIC_: SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Google OAuth is configured in the Supabase dashboard + Google console (see docs/supabase-setup.md).
# Meta Model API keys are never stored in this repo. No model calls in Phase 1/2.

# Phase 3 server/worker settings. Defaults remain disabled; no real values here.
# WORLDSPEAK_INFERENCE_API_ENABLED=false
# INFERENCE_DATABASE_URL=  # dedicated login inheriting worldspeak_inference_worker
# META_MODEL_API_KEY=      # Standard Meta Model API key; worker only
# WORLDSPEAK_LIVE_INFERENCE_APPROVED=  # unset until explicit two-call approval
# Budget limits AND generation permits also default to zero in migration 007.
