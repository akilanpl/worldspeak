{
  "name": "worldspeak",
  "version": "0.1.0",
  "private": true,
  "description": "WorldSpeak Phase 1: local offline bilingual communication slice",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --config apps/web/playwright.config.ts",
    "build": "node scripts/build-offline.mjs && pnpm --filter @worldspeak/web build",
    "pretest": "node scripts/build-offline.mjs",
    "pretypecheck": "node scripts/build-offline.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "pnpm --filter @worldspeak/web dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
